# Server-side: where Next.js proxies /api/* (rewrites in next.config.ts). Prod: the API's public URL.
# Read at `next dev` start / `next build`, so set it before building.
API_ORIGIN=http://localhost:4100

# Optional: base URL the browser uses for API calls. Defaults to /api (same origin, via the rewrite above),
# which keeps the session cookie first-party. Only override if you know you need to.
# NEXT_PUBLIC_API_URL=/api

# Production (Vercel) only: same value as API_PROXY_SECRET on the API. Lets the API trust the client IP Vercel forwards.
# API_PROXY_SECRET=
