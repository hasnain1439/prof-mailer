generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// All DateTime columns are stored in UTC. The UI renders them in Asia/Karachi.
// Every user-owned row carries userId; all queries are scoped by it.

enum ProfessorStatus {
  NOT_SENT
  SENT
  REPLIED
  INTERESTED
  DECLINED
}

enum EmailStatus {
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}

model User {
  id           String        @id @default(cuid())
  googleSub    String        @unique
  email        String
  name         String?
  picture      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     Session[]
  professors   Professor[]
  templates    Template[]
  emails       Email[]
  settings     Settings?
  gmailAccount GmailAccount?
}

// id = sha256(hex) of the random session token held in the pm_session cookie.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
}

model Professor {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  email         String
  university    String
  country       String?
  researchFocus String?
  whyFits       String?
  profileUrl    String?
  status        ProfessorStatus @default(NOT_SENT)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  emails        Email[]

  @@unique([userId, email])
  @@index([userId])
  @@index([status])
  @@index([country])
}

model Template {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  subject    String
  body       String
  isFollowUp Boolean  @default(false)
  isHtml     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  emails     Email[]

  @@index([userId])
}

model Email {
  id              String      @id @default(cuid())
  // Denormalised from professor.userId for fast scoping.
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  professorId     String
  professor       Professor   @relation(fields: [professorId], references: [id], onDelete: Cascade)
  templateId      String?
  template        Template?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  subject         String
  body            String
  isHtml          Boolean     @default(false)
  status          EmailStatus @default(SCHEDULED)
  scheduledAt     DateTime
  sentAt          DateTime?
  repliedAt       DateTime?
  error           String?
  gmailThreadId   String?
  gmailMessageId  String? // Gmail API message id
  messageIdHeader String? // RFC 5322 Message-ID header, e.g. <abc@mail.gmail.com>
  followUpNo      Int         @default(0)
  parentId        String?
  parent          Email?      @relation("FollowUps", fields: [parentId], references: [id], onDelete: SetNull)
  followUps       Email[]     @relation("FollowUps")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId, status, scheduledAt])
  @@index([status, scheduledAt])
  @@index([professorId])
  @@index([gmailThreadId])
}

// One row per user (created with defaults on first read).
model Settings {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  followUpAfterDays  Int       @default(3)
  maxFollowUps       Int       @default(2)
  dailySendLimit     Int       @default(20)
  followUpTemplateId String?
  // Spacing between sends: the scheduler won't send for this user before this instant.
  nextSendAfter      DateTime?
  updatedAt          DateTime  @updatedAt
}

// Global key/value state for the scheduler (e.g. lastReplyCheckAt), so restarts don't re-run jobs early.
model AppState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum GmailAuthType {
  OAUTH
  APP_PASSWORD
}

// One connected Gmail account per user.
// OAUTH: refreshToken (+ accessToken) set. APP_PASSWORD: appPasswordEnc set (AES-256-GCM, see src/lib/crypto.ts).
model GmailAccount {
  id             String        @id @default(cuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  email          String
  authType       GmailAuthType @default(OAUTH)
  refreshToken   String?
  accessToken    String?
  expiryDate     DateTime?
  appPasswordEnc String?
  connectedAt    DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}
