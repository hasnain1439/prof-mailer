generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// All DateTime columns are stored in UTC. The UI renders them in Asia/Karachi.
// Every user-owned row carries userId; all queries are scoped by it.

enum ProfessorStatus {
  NOT_SENT
  SENT
  REPLIED
  INTERESTED
  INTERVIEW
  DECLINED
}

// A contact is either a professor (Master's admissions) or a company (job applications).
enum ContactKind {
  PROFESSOR
  COMPANY
}

enum EmailStatus {
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}

// Email + password accounts. email is stored trimmed + lowercased.
model User {
  id              String        @id @default(cuid())
  email           String        @unique
  name            String?
  // "scrypt$N$r$p$<salt b64>$<hash b64>" (src/lib/password.ts)
  passwordHash    String? // null until the user sets it on the verification page
  emailVerifiedAt DateTime?
  // Set by an admin: no sign-in, no API access, the scheduler skips the user's emails.
  blockedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  sessions        Session[]
  authTokens      AuthToken[]
  professors      Professor[]
  templates       Template[]
  emails          Email[]
  settings        Settings?
  gmailAccount    GmailAccount?
  cv              UserCv?
  reminders       Reminder[]
}

enum AuthTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

// One-time email links. id = sha256(hex) of the 32-byte random token sent by email.
model AuthToken {
  id        String        @id
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

// id = sha256(hex) of the random session token held in the pm_session cookie.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
}

// A contact (professor or company). For companies, `university` holds the company name and `name` the
// recruiter / HR person (or a team name such as "Hiring Team").
model Professor {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          ContactKind     @default(PROFESSOR)
  name          String
  email         String
  university    String
  role          String? // companies: the job title applied for
  jobUrl        String? // companies: link to the job posting
  country       String?
  researchFocus String?
  whyFits       String?
  profileUrl    String?
  status        ProfessorStatus @default(NOT_SENT)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  emails        Email[]
  reminders     Reminder[]

  @@unique([userId, email])
  @@index([userId])
  @@index([status])
  @@index([country])
  @@index([userId, kind])
}

model Template {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  subject    String
  body       String
  isFollowUp Boolean  @default(false)
  isHtml     Boolean  @default(false)
  // Attach the user's CV (UserCv) to emails created from this template.
  attachCv   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  emails     Email[]

  @@index([userId])
}

model Email {
  id              String      @id @default(cuid())
  // Denormalised from professor.userId for fast scoping.
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  professorId     String
  professor       Professor   @relation(fields: [professorId], references: [id], onDelete: Cascade)
  templateId      String?
  template        Template?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  subject         String
  body            String
  isHtml          Boolean     @default(false)
  // Attach the user's CV at send time (copied from the template when the email is created).
  attachCv        Boolean     @default(false)
  status          EmailStatus @default(SCHEDULED)
  scheduledAt     DateTime
  sentAt          DateTime?
  repliedAt       DateTime?
  error           String?
  gmailThreadId   String?
  gmailMessageId  String? // Gmail API message id
  messageIdHeader String? // RFC 5322 Message-ID header, e.g. <abc@mail.gmail.com>
  followUpNo      Int         @default(0)
  parentId        String?
  parent          Email?      @relation("FollowUps", fields: [parentId], references: [id], onDelete: SetNull)
  followUps       Email[]     @relation("FollowUps")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId, status, scheduledAt])
  @@index([status, scheduledAt])
  @@index([professorId])
  @@index([gmailThreadId])
}

// One row per user (created with defaults on first read).
model Settings {
  id                        String    @id @default(cuid())
  userId                    String    @unique
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  followUpAfterDays         Int       @default(3)
  maxFollowUps              Int       @default(2)
  dailySendLimit            Int       @default(20)
  followUpTemplateId        String?
  // Follow-up template for COMPANY contacts (null = fall back to followUpTemplateId).
  companyFollowUpTemplateId String?
  // Spacing between sends: the scheduler won't send for this user before this instant.
  nextSendAfter             DateTime?
  // Sender profile, filled into templates as {{myName}}, {{myTitle}}, ... (services/core/sender.ts).
  myName                    String?
  myTitle                   String?
  myEmail                   String?
  myPhone                   String?
  myLinkedIn                String?
  myPortfolio               String?
  myEducation               String?
  mySummary                 String?
  updatedAt                 DateTime  @updatedAt
}

// Global key/value state for the scheduler (e.g. lastReplyCheckAt), so restarts don't re-run jobs early.
model AppState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum GmailAuthType {
  APP_PASSWORD
}

// One connected Gmail account per user: address + Google App Password (SMTP send, IMAP reply checks).
// appPasswordEnc is AES-256-GCM encrypted (see src/lib/crypto.ts).
model GmailAccount {
  id             String        @id @default(cuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  email          String
  authType       GmailAuthType @default(APP_PASSWORD)
  appPasswordEnc String?
  connectedAt    DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// The user's CV (one per user), attached to emails whose attachCv is true. PDF/DOC/DOCX, max 5 MB.
model UserCv {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String
  size       Int
  // Stored in the database (data) or, when R2 is configured, in Cloudflare R2 (storageKey; data null).
  data       Bytes?
  storageKey String?
  updatedAt  DateTime @updatedAt
}

// A personal reminder, optionally tied to a professor or company. When dueAt passes the tick job
// emails the user once (notifiedAt). Done reminders (doneAt) are never emailed.
model Reminder {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Professor? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  title      String
  note       String?
  dueAt      DateTime
  doneAt     DateTime?
  notifiedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId, doneAt, dueAt])
  @@index([dueAt, notifiedAt])
  @@index([contactId])
}
