# --- Database (Neon) ---
# Pooled connection, used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection, used by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Server ---
PORT=4100
# The web app's origin (the browser only talks to it; Next.js rewrites /api/* to this API).
# Email links point here: ${PUBLIC_URL}/verify-email?token=... and ${PUBLIC_URL}/reset-password?token=...
PUBLIC_URL=http://localhost:3100
# Secure cookies. Defaults to true when NODE_ENV=production, false otherwise.
# COOKIE_SECURE=false

# --- Sign-in ---
# Local QA only: POST /api/auth/dev-login {email} signs in without a password. Ignored when NODE_ENV=production.
DEV_LOGIN_ENABLED=false

# --- Admins ---
# Comma-separated login emails (case-insensitive) of accounts that get the Admin page (/admin).
# Sign up normally, put your email here, restart the API. Empty = no admins.
ADMIN_EMAILS=

# --- System mail (verification + password reset links), sent from the app owner's mailbox ---
# Required in production. Locally, leave SMTP_HOST empty and the links are printed to the API console.
# Not affected by DRY_RUN. Port 465 = implicit TLS (SMTP_SECURE defaults to true), 587 = STARTTLS (SMTP_SECURE=false).
SMTP_HOST=
# e.g. SMTP_HOST=mail.example.org
SMTP_PORT=465
# SMTP_SECURE=true
SMTP_USER=
# e.g. SMTP_USER=no-reply@example.org
SMTP_PASS=
MAIL_FROM=
# e.g. MAIL_FROM="prof-mailer <no-reply@example.org>"

# --- Sending safety ---
# true (default): professor emails are only logged, never sent. Set to false to send for real.
# (Users connect Gmail with an App Password: smtp.gmail.com:465 + imap.gmail.com:993 must be reachable.)
DRY_RUN=true

# --- Cron ---
# Bearer secret for /api/jobs/tick, /api/jobs/send-due, /api/jobs/check-replies (required in production).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Empty in dev = those endpoints are disabled (the in-process scheduler still runs).
CRON_SECRET=

# --- Secret storage ---
# 32-byte key (64 hex chars or base64) used to encrypt stored Gmail App Passwords. REQUIRED in production.
# In dev, if empty, a key is generated once into api/.data/secret.key (gitignored).
# ENCRYPTION_KEY=

# --- Scheduler ---
SCHEDULER_ENABLED=true
# Random minimum gap between two sends of the same user.
SEND_DELAY_MIN_MS=30000
SEND_DELAY_MAX_MS=120000

# --- Proxy ---
# Production: same value as API_PROXY_SECRET on Vercel (lets the API trust the browser IP for rate limits).
# API_PROXY_SECRET=
# TRUST_PROXY_HOPS=1

# Optional: Claude API key for "Write with AI" drafts (https://console.anthropic.com). Without it the AI button is hidden.
ANTHROPIC_API_KEY=

# Optional: store CV files in a private Cloudflare R2 bucket instead of the database.
# R2 dashboard -> Manage API tokens -> "Object Read & Write" on this bucket. Leave empty to keep CVs in the DB.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional: "Sign in with Google". Create an OAuth client (Web application) in Google Cloud Console and add the
# redirect URI {PUBLIC_URL}/api/auth/google/callback. Leave empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
