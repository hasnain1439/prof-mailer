# --- Database (Neon) ---
# Pooled connection, used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection, used by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Server ---
PORT=4000
CORS_ORIGIN=http://localhost:3000
WEB_URL=http://localhost:3000

# --- Sending safety ---
# true (default): emails are only logged, never sent. Set to false to send for real.
DRY_RUN=true
# The only address the "test send" button will ever email.
TEST_RECIPIENT=you@example.com

# --- Google OAuth (Gmail) ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/gmail/callback

# --- Secret storage ---
# Optional. 32-byte key (64 hex chars or base64) used to encrypt the Gmail app password in the DB.
# If empty, a key is generated once into api/.data/secret.key (keep that file; it is gitignored).
# ENCRYPTION_KEY=

# --- Scheduler ---
SCHEDULER_ENABLED=true
SEND_DELAY_MIN_MS=30000
SEND_DELAY_MAX_MS=120000
